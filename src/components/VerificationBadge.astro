---
// Tiers as implemented by functions/v2/robots/[rrn]/verify-tier.ts and register.ts.
// No tier certifies a robot; see docs.robotregistryfoundation.org/verification.
type Tier = 'unverified' | 'community' | 'manufacturer_claimed' | 'manufacturer_verified';

interface Props {
  status: Tier | string;
  size?: 'sm' | 'md';
}

const { status, size = 'md' } = Astro.props;

const tiers: Record<Tier, { icon: string; label: string; classes: string }> = {
  unverified: {
    icon: '·',
    label: 'Unverified',
    classes: 'bg-gray-500/10 text-gray-400 border-gray-500/30',
  },
  community: {
    icon: '⬜',
    label: 'Community',
    classes: 'bg-gray-500/10 text-gray-300 border-gray-500/30',
  },
  manufacturer_claimed: {
    icon: '🟡',
    label: 'Manufacturer claimed',
    classes: 'bg-amber-500/10 text-amber-400 border-amber-500/30',
  },
  manufacturer_verified: {
    icon: '🔵',
    label: 'Manufacturer verified',
    classes: 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  },
};

const tier = tiers[status as Tier] ?? tiers.unverified;
const sizeClasses = size === 'sm' ? 'text-xs px-2 py-0.5' : 'text-xs px-2.5 py-1';
---

<span class:list={[
  "inline-flex items-center gap-1 rounded-full border font-medium font-mono",
  tier.classes,
  sizeClasses,
]}>
  <span>{tier.icon}</span>
  <span>{tier.label}</span>
</span>
